{
  "name": "linemap",
  "version": "1.0.0",
  "description": "Linemap: a local Excalidraw workbench you and your coding agents share. MCP server, CLI, live canvas, projects, versions, notes and agent chat.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "linemap": "dist/bin.js",
    "excalidraw-mcp": "dist/bin.js"
  },
  "scripts": {
    "build": "bun run build:frontend && bun run build:server",
    "build:frontend": "bunx --bun vite build",
    "build:server": "bun scripts/build.ts",
    "dev": "concurrently -n server,web -c blue,magenta \"bun --watch src/server.ts\" \"bunx --bun vite\"",
    "serve": "bun dist/bin.js up --open",
    "serve:quiet": "bun dist/bin.js up --open --quiet",
    "serve:node": "node dist/bin.js up --open",
    "logs": "bun dist/bin.js logs -f",
    "mcp": "bun dist/bin.js",
    "cli": "bun dist/bin.js",
    "canvas": "bun dist/server.js",
    "test": "bun run test:mcp && bun run test:bind && bun run test:render && bun run test:state && bun run test:workspace && bun run test:agent",
    "test:mcp": "bun scripts/check-mcp-stdio.mjs",
    "test:bind": "bun scripts/check-local-bind.mjs",
    "test:render": "bun scripts/check-render.mjs",
    "test:state": "bun scripts/check-state-integrity.mjs",
    "test:workspace": "bun scripts/check-workspace.mjs",
    "test:agent": "bun scripts/check-agent.mjs",
    "test:node": "MCP_RUNTIME=node CANVAS_RUNTIME=node node scripts/check-mcp-stdio.mjs && node scripts/check-workspace.mjs && node scripts/check-agent.mjs",
    "test:canvas": "bunx playwright test",
    "capture:review": "node scripts/capture-review.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^3.1.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "fractional-indexing": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wawoff2": "^2.0.1"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "private": true,
  "files": [
    "src/**/*",
    "dist/**/*",
    "skills/**/*",
    "assets/**/*",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.2"
}
